{
  "name": "Shulker — Bedrock Add-On Validator",
  "short_name": "Shulker",
  "description": "Validate Minecraft Bedrock .mcworld, .mcaddon, .mcpack files and BP/RP folders offline in your browser.",
  "start_url": "./",
